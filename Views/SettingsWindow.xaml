<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Launcher.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Launcher"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="設定">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="24,24,24,16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <NavigationView
            Grid.Row="0"
            x:Name="SettingsNavigationView"
            PaneDisplayMode="Left"
            OpenPaneLength="200"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="False"
            SelectionChanged="SettingsNavigationView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="ショートカット" Tag="Shortcuts" IsSelected="True" />
                <NavigationViewItem Content="表示" Tag="Display" />
                <NavigationViewItem Content="起動" Tag="Startup" />
                <NavigationViewItem Content="登録アプリ" Tag="Apps" />
            </NavigationView.MenuItems>

            <Grid Margin="16,0,0,0">
                <ScrollViewer x:Name="ShortcutsPanel" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                    <StackPanel Spacing="24" Margin="0,16,0,0">
                        <local:HotKeyEditor
                            x:Name="ToggleWindowHotKeyEditor"
                            Title="グローバルホットキー"
                            Description="ランチャーウィンドウの表示・非表示を切り替えるショートカットキーです。" />

                        <local:HotKeyEditor
                            x:Name="ExpandIconsHotKeyEditor"
                            Title="アイコン一覧の展開ショートカット"
                            Description="ランチャーウィンドウ表示中にこのキーを押すと、登録アプリのアイコン一覧を表示・非表示します。" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="DisplayPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Spacing="24" Margin="0,16,0,0">
                        <StackPanel Spacing="8">
                            <TextBlock Text="表示位置" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock
                                Text="ランチャーウィンドウを表示する位置を選択します。固定位置は画面左上を基準にした座標（ピクセル）で指定します。「座標を指定」を押すとプレビューがマウスに追従するので、配置したい位置でクリックしてください（右クリックでキャンセル）。"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Opacity="0.7"
                                TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <RadioButton
                                    x:Name="PositionCursorRadioButton"
                                    Content="マウスカーソル位置に表示"
                                    GroupName="PositionMode"
                                    Checked="PositionModeRadioButton_Checked" />
                                <RadioButton
                                    x:Name="PositionFixedRadioButton"
                                    Content="固定位置に表示"
                                    GroupName="PositionMode"
                                    Checked="PositionModeRadioButton_Checked" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <NumberBox
                                    x:Name="FixedPositionXNumberBox"
                                    Width="110"
                                    Header="X座標"
                                    SpinButtonPlacementMode="Inline"
                                    SmallChange="10" />
                                <NumberBox
                                    x:Name="FixedPositionYNumberBox"
                                    Width="110"
                                    Header="Y座標"
                                    SpinButtonPlacementMode="Inline"
                                    SmallChange="10" />
                                <Button
                                    x:Name="PickPositionButton"
                                    Content="座標を指定"
                                    VerticalAlignment="Bottom"
                                    Click="PickPositionButton_Click" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="ランチャーのテキストボックスのフォント" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <ComboBox
                                    x:Name="FontFamilyComboBox"
                                    Width="300"
                                    IsEditable="True"
                                    PlaceholderText="フォントファミリー" />
                                <NumberBox
                                    x:Name="FontSizeNumberBox"
                                    Width="128"
                                    Minimum="8"
                                    Maximum="72"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Inline" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel x:Name="StartupPanel" Spacing="8" Margin="0,16,0,0" Visibility="Collapsed">
                    <TextBlock Text="起動" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <CheckBox x:Name="StartupCheckBox" Content="Windows起動時に自動的に起動する" />
                </StackPanel>

                <Grid x:Name="AppsPanel" RowSpacing="8" Margin="0,16,0,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="登録アプリケーション" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" x:Name="AddAppButton" Content="追加" Click="AddAppButton_Click" />
                    </Grid>

                    <ListView Grid.Row="1" x:Name="AppsListView" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,8" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding Name, Mode=TwoWay}" PlaceholderText="表示名" />
                                            <TextBox
                                                Grid.Column="1"
                                                Text="{Binding Arguments, Mode=TwoWay}"
                                                PlaceholderText="引数（任意）"
                                                FontSize="11" />
                                        </Grid>
                                        <TextBlock
                                            Text="{Binding Path}"
                                            Opacity="0.8"
                                            FontSize="12"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{Binding Path}" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Content="削除"
                                        VerticalAlignment="Center"
                                        Click="RemoveAppButton_Click"
                                        Tag="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </NavigationView>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="CancelButton" Content="キャンセル" Click="CancelButton_Click" />
            <Button x:Name="SaveButton" Content="保存" Style="{StaticResource AccentButtonStyle}" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
